#!/bin/sh
# Short command for people (macOS/Linux): harness <command> ...
# Same as: python3 .harness/engine/cli.py <command> ...  Works from any folder, also through a link in PATH.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
here=$(cd "$(dirname "$self")" && pwd)
# Try each name and check that it really runs: on Windows, python3 can be a Store stub that exists but exits with 49.
for py in python3 python; do
  if "$py" -c "" >/dev/null 2>&1; then
    exec "$py" "$here/../engine/cli.py" "$@"
  fi
done
echo "harness: no working python3 or python found" >&2
exit 127
