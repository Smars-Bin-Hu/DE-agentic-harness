{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "bash": "python3 .harness/task-policy/task_policy.py hook --runtime copilot --event SessionStart",
        "powershell": "python .harness/task-policy/task_policy.py hook --runtime copilot --event SessionStart",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "bash": "python3 .harness/task-policy/task_policy.py hook --runtime copilot --event UserPromptSubmit",
        "powershell": "python .harness/task-policy/task_policy.py hook --runtime copilot --event UserPromptSubmit",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "*",
        "bash": "python3 .harness/task-policy/task_policy.py hook --runtime copilot --event PreToolUse",
        "powershell": "python .harness/task-policy/task_policy.py hook --runtime copilot --event PreToolUse",
        "cwd": ".",
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "matcher": "*",
        "bash": "python3 .harness/task-policy/task_policy.py hook --runtime copilot --event PostToolUse",
        "powershell": "python .harness/task-policy/task_policy.py hook --runtime copilot --event PostToolUse",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
